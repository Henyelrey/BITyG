  create temporary table "hecho_inventario__dbt_tmp030228969010"
  
  
    as
  
  (
    

WITH source_data AS (
    SELECT
        r.recepcion_id,
        r.oficina_id,
        r.producto_id,
        r.fecha_recepcion,
        r.lote,
        r.estado_recepcion,
        r.dias_inactivo,
        r.ingresado_sin_venta,
        v.fecha_venta,
        r.updated_at,
        NOW() AS _dbt_updated_at
    FROM "tyg_datamart"."raw"."recepciones" r
    LEFT JOIN "tyg_datamart"."raw"."ventas" v ON r.recepcion_id = v.recepcion_id
    
    
