  create temporary table "dim_oficina__dbt_tmp015342165293"
  
  
    as
  
  (
    -- =============================================================
-- dim_oficina.sql — Dimensión Oficina
-- Jerarquía: Región → Departamento → Zona → Oficina
-- SCD Tipo 1: ON CONFLICT DO UPDATE (sobrescribe cambios)
-- =============================================================


SELECT
    oficina_id,
    nom_oficina,
    departamento,
    region,
    zona,
    NOW() AS _dbt_updated_at
FROM "tyg_datamart"."raw"."oficinas"


WHERE updated_at > (
    SELECT COALESCE(MAX(_dbt_updated_at), '1900-01-01'::TIMESTAMP) 
    FROM "tyg_datamart"."marts_marts"."dim_oficina"
)

  );
  
  
