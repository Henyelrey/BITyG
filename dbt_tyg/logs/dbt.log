  (
    

WITH source_data AS (
    SELECT
        r.recepcion_id,
        r.oficina_id,
        r.producto_id,
        r.fecha_recepcion,
        r.lote,
        r.estado_recepcion,
        r.dias_inactivo,
        r.ingresado_sin_venta,
        v.fecha_venta,
        r.updated_at,
        NOW() AS _dbt_updated_at
    FROM "tyg_datamart"."raw"."recepciones" r
    LEFT JOIN "tyg_datamart"."raw"."ventas" v ON r.recepcion_id = v.recepcion_id
    
    
    WHERE r.updated_at > (SELECT COALESCE(MAX(_dbt_updated_at), '1900-01-01'::TIMESTAMP) FROM "tyg_datamart"."marts_marts"."hecho_inventario")
    
)

SELECT
    recepcion_id,
    oficina_id,
    producto_id,
    fecha_recepcion,
    lote,
    estado_recepcion,
    dias_inactivo,
    ingresado_sin_venta,
    fecha_venta,
    updated_at,
    _dbt_updated_at
FROM source_data
  );
  
  
