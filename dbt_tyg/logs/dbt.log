  create temporary table "dim_oficina__dbt_tmp044109945453"
  
  
    as
  
  (
    

WITH source_data AS (
    SELECT
        oficina_id,
        nom_oficina,
        departamento,
        region,
        zona,
        updated_at
    FROM "tyg_datamart"."raw"."oficinas"
    
    
