  create temporary table "hecho_inventario__dbt_tmp024949227585"
  
  
    as
  
  (
    

WITH source_data AS (
    SELECT
        r.recepcion_id,
        r.oficina_id,
        r.producto_id,
        r.fecha_recepcion,
        r.lote,
        r.estado_recepcion,
        r.dias_inactivo,
        r.ingresado_sin_venta,
        v.fecha_venta,
        r.updated_at,  -- ✅ Calificado con r.
        
        -- Campos calculados
        (v.fecha_venta::DATE - r.fecha_recepcion::DATE) AS dias_rotacion,
        
        CASE 
            WHEN r.dias_inactivo > 90 
            AND r.estado_recepcion <> 'VENDIDO'
            THEN TRUE 
            ELSE FALSE 
        END AS es_riesgo_90d
        
    FROM "tyg_datamart"."raw"."recepciones" r
    LEFT JOIN "tyg_datamart"."raw"."ventas" v ON r.recepcion_id = v.recepcion_id

    
    WHERE r.updated_at > (
        SELECT COALESCE(MAX(t.updated_at), '2000-01-01'::TIMESTAMP) 
        FROM "tyg_datamart"."marts_marts"."hecho_inventario" t
    )

)

SELECT
    recepcion_id,
    oficina_id,
    producto_id,
    fecha_recepcion,
    lote,
    estado_recepcion,
    dias_inactivo,
    ingresado_sin_venta,
    dias_rotacion,
    es_riesgo_90d,
    updated_at
FROM source_data
  );
  
  
