  create view "tyg_datamart"."marts_staging"."stg_ventas__dbt_tmp"
    
    
  as (
    -- =============================================================
-- stg_ventas.sql — Staging: Vista enriquecida de ventas
-- Aplica la lógica de negocio G de TyG (vista vw_g_ventas_tyg)
-- pero en PostgreSQL sobre datos ya replicados en raw.
-- Materializada como VIEW (no ocupa espacio, siempre fresca).
-- =============================================================


SELECT
    v.venta_id,
    v.oficina_id,
    v.vendedor_id,
    v.asesor_pdv_id,
    v.producto_id,
    v.recepcion_id,
    v.fecha_venta,
    v.canal_venta,
    v.estado_venta,

    -- KPI P1-2 / P3-1: Monto diferenciado por canal (regla de negocio TyG)
    CASE
        WHEN v.canal_venta = 'DIRECTO' THEN 220.00
        WHEN v.canal_venta = 'PDV'     THEN 160.00
        ELSE v.monto_venta
    END::NUMERIC(10,2) AS monto_calculado,

    -- Datos de recepción (inventario)
    r.fecha_recepcion,
    r.estado_recepcion,
    r.dias_inactivo,
    r.lote,

    -- KPI P2-3: Rotación de lote (días entre recepción y venta)
    EXTRACT(DAY FROM (v.fecha_venta::DATE - r.fecha_recepcion::DATE))::INT
        AS dias_rotacion,

    -- KPI P2-1: Flag riesgo inventario > 90 días
    CASE
        WHEN EXTRACT(DAY FROM (v.fecha_venta::DATE - r.fecha_recepcion::DATE)) > 90
         AND r.estado_recepcion <> 'VENDIDO'
        THEN TRUE ELSE FALSE
    END AS es_riesgo_90d,

    -- KPI P1-1: Activación real
    COALESCE(a.flag_activo, FALSE) AS es_activacion,

    -- Trazabilidad de lote
    r.lote AS serie_lote,

    v.updated_at AS src_updated_at

FROM "tyg_datamart"."raw"."ventas" v
LEFT JOIN "tyg_datamart"."raw"."recepciones"  r ON v.recepcion_id = r.recepcion_id
LEFT JOIN "tyg_datamart"."raw"."activaciones" a ON v.venta_id     = a.venta_id
  );
