    -- =============================================================
-- dim_oficina.sql — Dimensión Oficina
-- Jerarquía: Región → Departamento → Zona → Oficina
-- SCD Tipo 1: ON CONFLICT DO UPDATE (sobrescribe cambios)
-- =============================================================


