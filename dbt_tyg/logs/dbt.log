  create temporary table "dim_oficina__dbt_tmp011556882946"
  
  
    as
  
  (
    -- =============================================================
-- dim_oficina.sql — Dimensión Oficina
-- Jerarquía: Región → Departamento → Zona → Oficina
-- SCD Tipo 1: ON CONFLICT DO UPDATE (sobrescribe cambios)
-- =============================================================


SELECT
    oficina_id,
    nom_oficina,
    departamento,
    region,
    zona
FROM "tyg_datamart"."raw"."oficinas"

WHERE updated_at > (
    SELECT COALESCE(MAX(_dbt_updated_at), '2000-01-01') FROM "tyg_datamart"."marts_marts"."dim_oficina"
)

  );
  
  
