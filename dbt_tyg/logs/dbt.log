  create  table "tyg_datamart"."marts_marts"."hecho_inventario"
  
  
    as
  
  (
    -- =============================================================
-- hecho_inventario.sql — Hechos de Inventario y Riesgo
-- KPIs: P2-1 Kits Riesgo 90d | P2-2 Días Inactivo | P2-3 Rotación
-- Grano: una fila por recepción (unidad de inventario)
-- =============================================================


SELECT
    r.recepcion_id,
    TO_CHAR(r.fecha_recepcion, 'YYYYMMDD')::INT     AS dtiem_id,
    r.oficina_id                                    AS dofic_id,
    r.recepcion_id                                  AS dest_id,

    -- KPI P2-2: Días inactivo
    COALESCE(r.dias_inactivo, 0)                   AS dias_inactivo,

    -- KPI P2-1: Flag riesgo > 90 días
    CASE
        WHEN COALESCE(r.dias_inactivo, 0) > 90
         AND r.estado_recepcion <> 'VENDIDO'
        THEN TRUE ELSE FALSE
    END                                             AS kits_riesgo_90d,

    -- KPI P2-3: Rotación de lote (días desde recepción hasta venta)
    EXTRACT(DAY FROM (v.fecha_venta::DATE - r.fecha_recepcion::DATE))::NUMERIC(8,2)
                                                   AS rotation_lote,

    r.lote                                         AS serie,
    NOW()                                          AS _dbt_updated_at

FROM "tyg_datamart"."raw"."recepciones" r
LEFT JOIN "tyg_datamart"."raw"."ventas" v ON r.recepcion_id = v.recepcion_id


  );
  
  
