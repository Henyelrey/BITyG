  create view "tyg_datamart"."marts_staging"."stg_ventas__dbt_tmp"
    
    
  as (
    

SELECT
    v.venta_id,
    v.oficina_id,  -- ✅ Calificado con v.
    v.vendedor_id,
    v.asesor_pdv_id,
    v.cliente_id,
