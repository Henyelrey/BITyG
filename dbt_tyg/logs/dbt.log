  create temporary table "hecho_inventario__dbt_tmp031321590935"
  
  
    as
  
  (
    

WITH source_data AS (
    SELECT
        r.recepcion_id,
        r.oficina_id,
        r.producto_id,
        r.fecha_recepcion,
        r.lote,
        r.estado_recepcion,
        r.dias_inactivo,
        r.ingresado_sin_venta,
        v.fecha_venta,
        r.updated_at,
        NOW() AS _dbt_updated_at
    FROM "tyg_datamart"."raw"."recepciones" r
    LEFT JOIN "tyg_datamart"."raw"."ventas" v ON r.recepcion_id = v.recepcion_id
    
    
    WHERE r.updated_at > (
        SELECT COALESCE(MAX(MAX(_dbt_updated_at)), '2000-01-01'::TIMESTAMP) 
        FROM "tyg_datamart"."marts_marts"."hecho_inventario"
    )
    
)

SELECT
    recepcion_id,
    -- Generar dtiem_id desde fecha_recepcion (formato YYYYMMDD)
    TO_CHAR(fecha_recepcion, 'YYYYMMDD')::INT AS dtiem_id,
    -- dofic_id es simplemente oficina_id
    oficina_id AS dofic_id,
    -- dest_id es recepcion_id
    recepcion_id AS dest_id,
    dias_inactivo,
    -- Calcular si es riesgo de 90 días
    CASE 
        WHEN dias_inactivo > 90 AND estado_recepcion <> 'VENDIDO'
        THEN TRUE 
        ELSE FALSE 
    END AS kits_riesgo_90d,
    -- Calcular rotación de lote (días entre recepción y venta)
    CASE 
        WHEN fecha_venta IS NOT NULL 
        THEN (fecha_venta::DATE - fecha_recepcion::DATE)::NUMERIC(8,2)
        ELSE NULL::NUMERIC(8,2)
    END AS rotation_lote,
    -- serie es simplemente lote
    lote AS serie,
    _dbt_updated_at
FROM source_data
  );
  
  
