  create temporary table "dim_tiempo__dbt_tmp034756820927"
  
  
    as
  
  (
    -- =============================================================
-- dim_tiempo.sql — Dimensión Tiempo
-- Genera la jerarquía: Año → Trimestre → Mes → Semana → Día
-- Incluye fechas de venta Y fechas de recepción (KPI P2)
-- Materialización incremental: agrega solo fechas nuevas.
-- =============================================================


WITH fechas_ventas AS (
    SELECT DISTINCT fecha_venta AS fecha
    FROM "tyg_datamart"."raw"."ventas"
    WHERE fecha_venta IS NOT NULL
    
      AND fecha_venta > (SELECT COALESCE(MAX(fecha), '2000-01-01') FROM "tyg_datamart"."marts_marts"."dim_tiempo")
    
),

fechas_recepciones AS (
    SELECT DISTINCT fecha_recepcion AS fecha
    FROM "tyg_datamart"."raw"."recepciones"
    WHERE fecha_recepcion IS NOT NULL
    
      AND fecha_recepcion > (SELECT COALESCE(MAX(fecha), '2000-01-01') FROM "tyg_datamart"."marts_marts"."dim_tiempo")
    
),

todas_fechas AS (
    SELECT fecha FROM fechas_ventas
    UNION
    SELECT fecha FROM fechas_recepciones
)

SELECT
    TO_CHAR(fecha, 'YYYYMMDD')::INT            AS dtiem_id,
    fecha,
    EXTRACT(DAY   FROM fecha)::SMALLINT        AS dia,
    EXTRACT(WEEK  FROM fecha)::SMALLINT        AS semana,
    EXTRACT(MONTH FROM fecha)::SMALLINT        AS mes,
    TO_CHAR(fecha, 'TMMonth')                  AS nombre_mes,
    EXTRACT(QUARTER FROM fecha)::SMALLINT      AS trimestre,
    EXTRACT(YEAR  FROM fecha)::SMALLINT        AS anio,
    NULL::DATE                                 AS fecha_recepcion,
    fecha                                      AS fecha_venta
FROM todas_fechas
  );
  
  
[0m03:47:56.842470 [debug] [Thread-3 (]: On model.tyg_datamart.hecho_canal: /* {"app": "dbt", "dbt_version": "1.8.2", "profile_name": "tyg_datamart", "target_name": "dev", "node_id": "model.tyg_datamart.hecho_canal"} */

    
  
    

  create temporary table "hecho_canal__dbt_tmp034756838184"
  
  
    as
  
  (
    -- =============================================================
-- hecho_canal.sql — Mix de Canal (Directo vs PDV)
-- KPI P3-1: % participación de cada canal por mes y oficina
-- Grano: mes × oficina
-- =============================================================


SELECT
    TO_CHAR(DATE_TRUNC('month', v.fecha_venta), 'YYYYMMDD')::INT  AS dtiem_id,
    v.oficina_id                                                    AS dofic_id,

    COUNT(*) FILTER (WHERE v.canal_venta = 'DIRECTO')              AS kits_canal_directo,
    COUNT(*) FILTER (WHERE v.canal_venta = 'PDV')                  AS kits_canal_pdv,

    SUM(CASE WHEN v.canal_venta = 'DIRECTO' THEN 220.00 ELSE 0 END)::NUMERIC(12,2)
                                                                   AS ingresos_directo,
    SUM(CASE WHEN v.canal_venta = 'PDV'     THEN 160.00 ELSE 0 END)::NUMERIC(12,2)
                                                                   AS ingresos_pdv,

    -- KPI P3-1: % kits canal DIRECTO sobre total del mes/oficina
    ROUND(
        COUNT(*) FILTER (WHERE v.canal_venta = 'DIRECTO')::NUMERIC
        / NULLIF(COUNT(*), 0) * 100
    , 2)                                                           AS mix_canal_pct,

    NOW()                                                          AS _dbt_updated_at

FROM "tyg_datamart"."raw"."ventas" v


WHERE v.fecha_venta >= (
    SELECT DATE_TRUNC('month', COALESCE(MAX(_dbt_updated_at), '2000-01-01'))
    FROM "tyg_datamart"."marts_marts"."hecho_canal"
)


GROUP BY 1, 2
  );
  
  
