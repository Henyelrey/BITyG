  create view "tyg_datamart"."marts_staging"."stg_ventas__dbt_tmp"
    
    
  as (
    

WITH source AS (
    SELECT * FROM "tyg_datamart"."raw"."ventas"
),

staging AS (
    SELECT
        venta_id,
        oficina_id,
        vendedor_id,
        asesor_pdv_id,
        cliente_id,
        producto_id,
        recepcion_id,
        fecha_venta,
        mes,
        monto_venta,
        canal_venta,
        estado_venta,
        created_at,
        updated_at,
        
        -- CORREGIDO: Calcular días sin usar EXTRACT
        -- PostgreSQL: fecha - fecha = INTEGER (días)
        CASE 
            WHEN r.fecha_recepcion IS NOT NULL 
            THEN (v.fecha_venta - r.fecha_recepcion)
            ELSE NULL 
        END AS dias_desde_recepcion
        
    FROM source v
    LEFT JOIN "tyg_datamart"."raw"."recepciones" r 
        ON v.recepcion_id = r.recepcion_id
)

SELECT * FROM staging
  );
