    recepcion_id,
    oficina_id,
    producto_id,
    fecha_recepcion,
    lote,
    estado_recepcion,
    dias_inactivo,
    ingresado_sin_venta,
    fecha_venta,
    updated_at,
    _dbt_updated_at
FROM source_data
  );
  
  
