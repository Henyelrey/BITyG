  as (
    

SELECT
    v.venta_id,
    v.oficina_id,  -- ✅ Calificado con v.
    v.vendedor_id,
    v.asesor_pdv_id,
    v.cliente_id,
    v.producto_id,
    v.recepcion_id,
    v.fecha_venta,
    v.mes,
    v.monto_venta,
    v.canal_venta,
    v.estado_venta,
    v.created_at,
    v.updated_at,
    
    -- Campos de recepción
    r.fecha_recepcion,
    r.estado_recepcion,
    r.dias_inactivo,
    r.ingresado_sin_venta,
    r.lote,
    
    -- Campos de activación
    a.flag_activo,
    
    -- Campos calculados
    (v.fecha_venta::DATE - r.fecha_recepcion::DATE) AS dias_rotacion,
    
    CASE 
        WHEN (v.fecha_venta::DATE - r.fecha_recepcion::DATE) > 90 
         AND r.estado_recepcion <> 'VENDIDO'
        THEN TRUE 
        ELSE FALSE 
    END AS es_riesgo_90d

FROM "tyg_datamart"."raw"."ventas" v
LEFT JOIN "tyg_datamart"."raw"."recepciones" r ON v.recepcion_id = r.recepcion_id
LEFT JOIN "tyg_datamart"."raw"."activaciones" a ON v.venta_id = a.venta_id
  );
