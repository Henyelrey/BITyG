  create temporary table "hecho_inventario__dbt_tmp031449757491"
  
  
    as
  
  (
    

WITH source_data AS (
    SELECT
        r.recepcion_id,
        r.oficina_id,
        r.producto_id,
        r.fecha_recepcion,
        r.lote,
        r.estado_recepcion,
        r.dias_inactivo,
        r.ingresado_sin_venta,
        v.fecha_venta,
        r.updated_at,
        NOW() AS _dbt_updated_at
    FROM "tyg_datamart"."raw"."recepciones" r
    LEFT JOIN "tyg_datamart"."raw"."ventas" v ON r.recepcion_id = v.recepcion_id
    
    -- ✅ CORRECCIÓN: Comparar fuente.updated_at vs destino._dbt_updated_at
    
    WHERE r.updated_at > (
        SELECT COALESCE(MAX(t._dbt_updated_at), '2000-01-01'::TIMESTAMP) 
        FROM "tyg_datamart"."marts_marts"."hecho_inventario" t
    )
    
)

SELECT
    recepcion_id,
    -- 🔑 Surrogate keys
    TO_CHAR(fecha_recepcion, 'YYYYMMDD')::INT AS dtiem_id,
    oficina_id AS dofic_id,
    recepcion_id AS dest_id,
    
    -- 📦 Atributos
    dias_inactivo,
    
    -- 🧮 KPIs calculados
    CASE 
        WHEN dias_inactivo > 90 AND estado_recepcion <> 'VENDIDO'
        THEN TRUE 
        ELSE FALSE 
    END AS kits_riesgo_90d,
    
    CASE 
        WHEN fecha_venta IS NOT NULL 
        THEN (fecha_venta::DATE - fecha_recepcion::DATE)::NUMERIC(8,2)
        ELSE NULL::NUMERIC(8,2)
    END AS rotation_lote,
    
    lote AS serie,
    
    -- 🔧 Metadata (esta es la columna que existe en el destino)
    _dbt_updated_at
FROM source_data
  );
  
  
