  create temporary table "hecho_inventario__dbt_tmp030457083886"
  
  
    as
  
  (
    

WITH source_data AS (
    SELECT
        r.recepcion_id,
        r.oficina_id,
        r.producto_id,
        r.fecha_recepcion,
        r.lote,
        r.estado_recepcion,
        r.dias_inactivo,
        r.ingresado_sin_venta,
        v.fecha_venta,
        r.updated_at,
        NOW() AS _dbt_updated_at
    FROM "tyg_datamart"."raw"."recepciones" r
    LEFT JOIN "tyg_datamart"."raw"."ventas" v ON r.recepcion_id = v.recepcion_id
    
    
    WHERE r.updated_at > (
        SELECT COALESCE(MAX(t.updated_at), '2000-01-01'::TIMESTAMP) 
        FROM "tyg_datamart"."marts_marts"."hecho_inventario" t
    )
    
)

SELECT
    recepcion_id,
    
    -- 🔑 Surrogate keys (formato entero YYYYMMDD para tiempo)
    TO_CHAR(fecha_recepcion, 'YYYYMMDD')::INT  AS dtiem_id,
    CASE WHEN fecha_venta IS NOT NULL 
         THEN TO_CHAR(fecha_venta, 'YYYYMMDD')::INT 
         ELSE NULL 
    END                                        AS dtiem_venta_id,
    oficina_id::INT                            AS dofic_id,
    recepcion_id::INT                          AS dest_id,
    producto_id::INT                           AS dprod_id,
    
    -- 📦 Atributos de inventario
    lote,
    estado_recepcion,
    dias_inactivo,
    ingresado_sin_venta,
    
    -- 🧮 KPIs calculados
    CASE 
        WHEN fecha_venta IS NOT NULL 
        THEN (fecha_venta::DATE - fecha_recepcion::DATE) 
        ELSE NULL 
    END                                        AS dias_rotacion,
    
    CASE 
        WHEN dias_inactivo > 90 AND estado_recepcion <> 'VENDIDO'
        THEN TRUE ELSE FALSE 
    END                                        AS es_riesgo_90d,
    
    -- 🔧 Metadata para CDC
    updated_at,
    _dbt_updated_at
    
FROM source_data
  );
  
  
