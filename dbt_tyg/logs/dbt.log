  create temporary table "hecho_inventario__dbt_tmp021149644069"
  
  
    as
  
  (
    

WITH source AS (
    SELECT * FROM "tyg_datamart"."raw"."recepciones"
),

enriched AS (
    SELECT
        r.recepcion_id,
        r.oficina_id,
        r.producto_id,
        r.fecha_recepcion,
        r.lote,
        r.estado_recepcion,
        r.dias_inactivo,
        r.ingresado_sin_venta,
        v.fecha_venta,
        r.created_at,
        r.updated_at,
        
        -- CORREGIDO: Calcular días sin usar EXTRACT
        -- PostgreSQL: fecha - fecha = INTEGER (días)
        CASE 
            WHEN v.fecha_venta IS NOT NULL 
            THEN (v.fecha_venta - r.fecha_recepcion)
            ELSE NULL 
        END AS dias_desde_recepcion,
        
        -- Flag de riesgo si han pasado más de 90 días
        CASE 
            WHEN r.dias_inactivo > 90 THEN TRUE
            ELSE FALSE
        END AS flag_riesgo_90d
        
    FROM source r
    LEFT JOIN "tyg_datamart"."raw"."ventas" v 
        ON r.recepcion_id = v.recepcion_id
    
    
    WHERE r.updated_at > (
        SELECT COALESCE(MAX(updated_at), '2000-01-01'::TIMESTAMP)
        FROM "tyg_datamart"."marts_marts"."hecho_inventario"
    )
    
)

SELECT
    recepcion_id AS hinv_id,
    recepcion_id,
    oficina_id,
    producto_id,
    fecha_recepcion,
    lote,
    estado_recepcion,
    dias_inactivo,
    ingresado_sin_venta,
    dias_desde_recepcion,
    flag_riesgo_90d,
    updated_at
FROM enriched
  );
  
  
